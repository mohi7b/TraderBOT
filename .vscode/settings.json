{
    // ============================================================
    // Why this file exists (2026-09-29)
    //
    // The VS Code extension host kept dying with
    //   "FATAL ERROR: Reached heap limit Allocation failed -
    //    JavaScript heap out of memory"  (ExtensionHostConnection)
    // — which closes the Cline chat webview and stops the session.
    //
    // Two causes, both addressed below:
    //   1. Default language-server budgets are too big for this box
    //      (~3.9 GB RAM): TypeScript server caps itself at 3072 MB
    //      and Pylance indexes the whole tree.
    //   2. The workspace is ~17 GB of data (collector/ 14 GB,
    //      collector/macro 8.8 GB, data/ 1.3 GB), and the file
    //      watcher + search index run *inside* the extension host.
    //
    // Nothing here changes how the code runs; it only stops editors
    // from loading 17 GB of data logs into the same heap as the chat.
    // ============================================================

    // ---------- 1. language servers: small, bounded budgets ----------
    "typescript.tsserver.maxTsServerMemory": 512,
    "typescript.tsserver.experimental.enableProjectDiagnostics": false,
    "typescript.disableAutomaticTypeAcquisition": true,
    "typescript.tsserver.log": "off",
    "python.analysis.indexing": false,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.userFileIndexingLimit": 500,
    "python.analysis.exclude": [
        "**/node_modules/**",
        "**/.next/**",
        "**/data/**",
        "**/collector/macro/offline/**",
        "**/collector/**/*.db",
        "**/*.csv",
        "**/logs/**"
    ],

    // ---------- 2. never watch / search / index the data lake ----------
    "files.maxMemoryForLargeFilesMB": 256,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.vscode-server/**": true,
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/.turbo/**": true,
        "**/.cache/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/coverage/**": true,
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/logs/**": true,
        "**/*.log": true,
        "**/*.db": true,
        "**/*.sqlite": true,
        "**/*.sst": true,
        "**/*.csv": true,
        "**/data/**": true,
        "**/collector/macro/offline/**": true,
        "**/collector/macro/raw/**": true,
        "**/collector/macro/**": true,
        "**/collector/crypto/data/**": true,
        "**/collector/crypto/historical/**": true,
        "**/*.ndjson": true,
        "**/*.jsonl": true,
        "**/_legacy/**": true,
        "**/.nested-git-backup/**": true,
        "**/*.parquet": true,
        "**/*.zip": true,
        "**/*.db-journal": true,
        "**/*.db-wal": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.next": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/dist": true,
        "**/build": true,
        "**/coverage": true,
        "**/__pycache__": true,
        "**/*.log": true,
        "**/*.db": true,
        "**/*.sqlite": true,
        "**/*.csv": true,
        "**/*.sst": true,
        "**/data": true,
        "**/collector/macro/offline": true,
        "**/collector/macro/raw": true,
        "**/collector/macro": true,
        "**/collector/crypto/historical": true,
        "**/*.ndjson": true,
        "**/*.jsonl": true,
        "**/_legacy": true,
        "**/.nested-git-backup": true,
        "**/*.parquet": true,
        "**/*.zip": true
    },
    "search.followSymlinks": false,
    "search.useIgnoreFiles": true,

    // ---------- 3. caches only: hidden from the explorer ----------
    // Source and data folders stay visible; only build output is hidden.
    "files.exclude": {
        "**/.next": true,
        "**/.turbo": true,
        "**/__pycache__": true
    },

    // ---------- 4. fewer live editors = less heap ----------
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": false,
    "workbench.editor.limit.excludeDirty": true,
    "editor.largeFileOptimizations": true,

    // ---------- 5. terminal: completion must be observable ----------
    // 2026-09-30: shell integration was turned off here, on the theory that
    // bash's OSC 633 debug trap plus a self-redirecting command (`tool > file`)
    // swallowed the "command finished" marker.
    //
    // 2026-10-04: that theory does not hold. The logs show the real event —
    // the extension host died of its own heap (SIGABRT) at 18:07 and again at
    // 18:25, a second extension host came up at 18:26, and every terminal the
    // agent had created belonged to the dead one. Nothing could be observed
    // afterwards, not even `true`, *because integration was off*: with it off
    // Cline has no reliable channel left for "this command finished".
    //
    // So integration is on again, and long commands no longer trust the
    // terminal at all: they run detached and write to a file
    // (scripts/dev/run-detached.sh), which survives a dropped pty.
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.history": 0,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.scrollback": 1000,

    // ---------- 6. background chores: fewer node workers, same heap ----------
    "git.autorefresh": false,
    "git.autofetch": false,
    "npm.autoDetect": "off",
    "extensions.autoUpdate": false,
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",

    // ---------- 7. nothing walks the 17 GB tree on its own (2026-09-30) ----------
    // The extension host on this box reached 2.35 GB RSS and kept growing until
    // node's heap limit killed it ("Reached heap limit"), which closes the chat.
    // Every automatic tree-walk below runs inside that same heap: task
    // auto-detection scans for build files, git decorations diff the tree,
    // auto-reveal stats the explorer, and the language servers keep per-file
    // caches. All of them are off; the settings above keep the big folders out.
    "task.autoDetect": "off",
    "explorer.autoReveal": false,
    "git.decorations.enabled": false,
    "scm.diffDecorations": "none",
    "breadcrumbs.enabled": false,
    "editor.codeLens": false,
    "search.searchOnType": false,
    "workbench.enableExperiments": false,
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "update.showReleaseNotes": false,
    "extensions.ignoreRecommendations": true,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "none",

    // ---------- 8. one setting, stated once ----------
    // `files.maxMemoryForLargeFilesMB` used to appear twice in this file (here
    // and in section 2). A duplicate key is how a settings file starts to lie
    // about itself, so the second copy is gone; the surviving one is above.
    // What is added here is the update check, which is the last thing that
    // walks the tree on its own without being asked.
    "extensions.autoCheckUpdates": false,

    // ---------- 9. search and symbols: bounded, and no symlink walks
    //               (2026-10-05) ----------
    // Measured this morning: the extension host was back at 1.75 GB RSS after
    // only 25 minutes of a chat-only session, and ~/.vscode-server/data/logs
    // holds two server starts before it (07:35, 07:49) — which is what "the
    // run was interrupted" means on this box: the process that owned the
    // terminal died, not the run. The tree is 61,264 files and 17 GB, and
    // every automatic walk still enabled happens *inside* that same heap, so
    // the remaining ones are turned down instead of off — nothing here changes
    // how the code runs, and no source folder is hidden from search.
    "search.followSymlinks": false,
    "search.maxResults": 2000,
    "search.quickOpen.includeSymbols": false,
    "search.quickOpen.includeHistory": false,
    "typescript.tsc.autoDetect": "off",
    "javascript.updateImportsOnFileMove.enabled": "never"
}
