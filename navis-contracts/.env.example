# ============================================================
# navois-contracts — deployment environment
#
# Copy to `.env` (git-ignored) and fill in. A shell prefix always
# wins over this file, so
#
#   PRIVATE_KEY=0x… npx hardhat run scripts/deploy.js --network bscTestnet
#
# needs no file at all.
# ============================================================

# ---------- signer ----------
# Private key of the funded deployer account. Required by every network
# except `hardhat` (the built-in node ships with its own accounts).
PRIVATE_KEY=

# ---------- network ----------
# Overrides the built-in default in hardhat.config.js.
#   mainnet : 0x61 -> 97 · testnet fallback: https://bsc-testnet.publicnode.com
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Optional: enables `npx hardhat verify --network bscTestnet …`.
BSCSCAN_API_KEY=

# ---------- infrastructure ----------
# Settlement token and DEX the market maker trades on.
#   - Set on a real network (mainnet) to the live USDT / Pancake router.
#   - Leave EMPTY on hardhat, localhost and bscTestnet: the repository then
#     deploys MockUSDT (6 decimals) and MockDEXRouter, which is what a seeded
#     test economy needs — the protocol's floor maths assume 6 decimals and a
#     supply we are able to mint.
USDT_ADDRESS=
DEX_ROUTER_ADDRESS=

# Arbitrage keeper of the market maker (defaults to the deployer).
KEEPER_ADDRESS=

# Emergency-stop delegate: owner of the pause()/unpause() entry points of the
# NAVIS token, the presale and the treasury (defaults to the deployer). The
# token is owned by the presale after the hand-off, so this role is what keeps
# the operator wallet able to freeze the protocol.
PAUSER_ADDRESS=

# ---------- vesting (team / marketing) ----------
# Whole-token amounts; empty or 0 skips the bucket. An amount mints that
# allocation to the Vesting contract and creates its schedule before the token
# ownership is handed to the presale. Cliff / duration are in days and default
# to the launch shape (team 365/1095, marketing 90/730); SHARE_PERCENT is the
# declared share of the supply (team 15, marketing 10) registered in the
# contract's role ledger, and REVOCABLE controls early termination.
VESTING_TEAM_NAVIS=
VESTING_TEAM_BENEFICIARY=
VESTING_TEAM_CLIFF_DAYS=
VESTING_TEAM_DURATION_DAYS=
VESTING_TEAM_SHARE_PERCENT=
VESTING_TEAM_REVOCABLE=
VESTING_MARKETING_NAVIS=
VESTING_MARKETING_BENEFICIARY=
VESTING_MARKETING_CLIFF_DAYS=
VESTING_MARKETING_DURATION_DAYS=
VESTING_MARKETING_SHARE_PERCENT=
VESTING_MARKETING_REVOCABLE=

# ---------- bootstrap / seeding ----------
# Whole-token amounts; empty or 0 skips the step. The reserve is what makes the
# NAV floor non-zero, so a fresh economy without it cannot sell anything.
BOOTSTRAP_SUPPLY_NAVIS=
BOOTSTRAP_RECEIVER=
SEED_RESERVE_USDT=
SEED_FLOAT_USDT=
